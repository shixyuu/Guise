+package libexclavecore
+
+// Guise: dual-network (Wi-Fi + cellular) per-connection split.
+//
+// The app installs a SocketBinder. Every socket created by the protected system dialer (and
+// every fd protected through protect_path, e.g. by byedpi) is offered to it right after
+// VpnService.protect(). Sockets whose stream settings carry GuiseSplitMark (set by the app's
+// config builder on outbounds that dial a remote proxy server) may be balanced across networks;
+// all others are "pinned" to the user's preferred single network. Loopback destinations are
+// never touched.
+
+import (
+	"net"
+	"sync"
+
+	v2rayNet "github.com/exclavenetwork/exclave-core/v5/common/net"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+	"google.golang.org/protobuf/proto"
+)
+
+// GuiseSplitMark is the sockopt "mark" the app puts on proxy-server outbounds. It is consumed
+// here and never set as SO_MARK.
+const GuiseSplitMark = 0x47554953 // "GUIS"
+
+type SocketBinder interface {
+	// BindSocket may bind fd to a specific Android network. destination is "ip:port" (may be
+	// empty for fds received through protect_path), split tells whether the socket dials a
+	// proxy server and may be balanced. Returns a label of the chosen network, or "".
+	BindSocket(fd int32, destination string, udp bool, split bool) string
+}
+
+var (
+	socketBinderAccess sync.RWMutex
+	socketBinder       SocketBinder
+)
+
+// SetSocketBinder installs (or with nil removes) the binder.
+func SetSocketBinder(binder SocketBinder) {
+	socketBinderAccess.Lock()
+	defer socketBinderAccess.Unlock()
+	socketBinder = binder
+}
+
+func currentSocketBinder() SocketBinder {
+	socketBinderAccess.RLock()
+	defer socketBinderAccess.RUnlock()
+	return socketBinder
+}
+
+// takeSplitMark reports whether sockopt carries GuiseSplitMark and returns sockopt without it.
+func takeSplitMark(sockopt *internet.SocketConfig) (bool, *internet.SocketConfig) {
+	if sockopt == nil || sockopt.Mark != GuiseSplitMark {
+		return false, sockopt
+	}
+	clean := proto.Clone(sockopt).(*internet.SocketConfig)
+	clean.Mark = 0
+	return true, clean
+}
+
+func bindDialSocket(fd int, dest v2rayNet.Destination, split bool) {
+	binder := currentSocketBinder()
+	if binder == nil || dest.Address == nil || !dest.Address.Family().IsIP() {
+		return
+	}
+	ip := dest.Address.IP()
+	if ip.IsLoopback() || ip.IsUnspecified() {
+		return
+	}
+	label := binder.BindSocket(int32(fd), net.JoinHostPort(ip.String(), dest.Port.String()),
+		dest.Network == v2rayNet.Network_UDP, split)
+	if label != "" && split {
+		newError("dual-network: ", dest.NetAddr(), " -> ", label).AtDebug().WriteToLog()
+	}
+}
+
+func bindProtectedFd(fd int) {
+	if binder := currentSocketBinder(); binder != nil {
+		binder.BindSocket(int32(fd), "", false, false)
+	}
+}
+
+// WithGuiseDialer installs the protected system dialer without VPN protection, so the socket
+// binder also sees sockets when Guise runs as a plain proxy service (no TUN).
+func (instance *V2RayInstance) WithGuiseDialer() {
+	if instance.resolver == nil {
+		panic("localResolver not set")
+	}
+	systemDialerMutex.Lock()
+	defer systemDialerMutex.Unlock()
+	internet.UseAlternativeSystemDialer(&protectedDialer{
+		protector: &noopProtector{},
+		resolver:  instance.resolver,
+	})
+}
+
+// ResetSystemDialer restores the default system dialer.
+func ResetSystemDialer() {
+	systemDialerMutex.Lock()
+	defer systemDialerMutex.Unlock()
+	internet.UseAlternativeSystemDialer(nil)
+}
