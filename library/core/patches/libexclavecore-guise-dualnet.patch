+package libexclavecore
+
+// Guise: active probing for UDP/QUIC split sessions (Hysteria2, TUIC, Juicity, mKCP, ...),
+// which have no TCP_INFO. Driven by the same 1 s sampler tick: bytes written to split UDP
+// sockets are counted; once "sample bytes" were sent AND the UDP probe interval has passed, one
+// probe round runs: for the (up to two) busiest UDP servers, one probe per available network,
+// bound to that network. Probe = QUIC version negotiation (1200-byte datagram with a reserved
+// version, every QUIC server answers), falling back to a TCP connect to the same ip:port
+// (SYN-ACK or RST), then off, for servers that answer neither. No traffic, no probes.
+
+import (
+	"net"
+	"net/netip"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/exclavenetwork/libexclavecore/dualnet"
+)
+
+const (
+	udpProbeTimeout  = 2 * time.Second
+	udpProbeMaxDests = 2
+	udpProbeDestIdle = 5 * time.Minute // forget per-server probe state after this
+)
+
+type udpCounter struct {
+	sent   atomic.Uint64
+	closed atomic.Bool
+}
+
+func (c *udpCounter) add(n int) {
+	if n > 0 {
+		c.sent.Add(uint64(n))
+	}
+}
+
+// countingUDPConn embeds *net.UDPConn so SyscallConn, SetReadBuffer, SetWriteBuffer, ReadMsgUDP,
+// WriteMsgUDP, etc. stay available to quic-go while every write path updates the byte counter.
+type countingUDPConn struct {
+	*net.UDPConn
+	ctr *udpCounter
+}
+
+func (c *countingUDPConn) Write(p []byte) (int, error) {
+	n, err := c.UDPConn.Write(p)
+	c.ctr.add(n)
+	return n, err
+}
+
+func (c *countingUDPConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	n, err := c.UDPConn.WriteTo(p, addr)
+	c.ctr.add(n)
+	return n, err
+}
+
+func (c *countingUDPConn) WriteToUDP(p []byte, addr *net.UDPAddr) (int, error) {
+	n, err := c.UDPConn.WriteToUDP(p, addr)
+	c.ctr.add(n)
+	return n, err
+}
+
+func (c *countingUDPConn) WriteToUDPAddrPort(p []byte, addr netip.AddrPort) (int, error) {
+	n, err := c.UDPConn.WriteToUDPAddrPort(p, addr)
+	c.ctr.add(n)
+	return n, err
+}
+
+func (c *countingUDPConn) WriteMsgUDP(p, oob []byte, addr *net.UDPAddr) (int, int, error) {
+	n, oobn, err := c.UDPConn.WriteMsgUDP(p, oob, addr)
+	c.ctr.add(n)
+	return n, oobn, err
+}
+
+func (c *countingUDPConn) WriteMsgUDPAddrPort(p, oob []byte, addr netip.AddrPort) (int, int, error) {
+	n, oobn, err := c.UDPConn.WriteMsgUDPAddrPort(p, oob, addr)
+	c.ctr.add(n)
+	return n, oobn, err
+}
+
+func (c *countingUDPConn) Close() error {
+	c.ctr.closed.Store(true)
+	return c.UDPConn.Close()
+}
+
+type countingPacketConn struct {
+	net.PacketConn
+	ctr *udpCounter
+}
+
+func (c *countingPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	n, err := c.PacketConn.WriteTo(p, addr)
+	c.ctr.add(n)
+	return n, err
+}
+
+func (c *countingPacketConn) Close() error {
+	c.ctr.closed.Store(true)
+	return c.PacketConn.Close()
+}
+
+type trackedUDP struct {
+	ctr      *udpCounter
+	dest     *net.UDPAddr
+	lastSent uint64
+}
+
+type udpDestState struct {
+	prober   dualnet.DestProber
+	lastSeen time.Time
+}
+
+var (
+	udpSchedule     dualnet.UDPSchedule
+	udpConns        = map[*trackedUDP]struct{}{}
+	udpDests        = map[string]*udpDestState{}
+	udpProtector    Protector
+	udpRoundRunning atomic.Bool
+)
+
+// SetDualNetUDPProbe sets the minimum seconds between UDP probe rounds (0 disables). Probing
+// also needs SetDualNetSampleBytes > 0, which is the traffic needed between two rounds.
+func SetDualNetUDPProbe(minIntervalSeconds int32) {
+	udpSchedule.Configure(samplerTrigger.Threshold(), time.Duration(minIntervalSeconds)*time.Second)
+}
+
+func resetUDPSampler() {
+	udpConns = map[*trackedUDP]struct{}{}
+	udpDests = map[string]*udpDestState{}
+}
+
+func trackSplitUDP(conn net.PacketConn, dest *net.UDPAddr, network string, protector Protector) net.PacketConn {
+	if !udpSchedule.Enabled() || dest == nil {
+		return conn
+	}
+	ctr := &udpCounter{}
+	var wrapped net.PacketConn
+	if u, ok := conn.(*net.UDPConn); ok {
+		wrapped = &countingUDPConn{UDPConn: u, ctr: ctr}
+	} else {
+		wrapped = &countingPacketConn{PacketConn: conn, ctr: ctr}
+	}
+	samplerAccess.Lock()
+	defer samplerAccess.Unlock()
+	udpConns[&trackedUDP{ctr: ctr, dest: dest}] = struct{}{}
+	udpProtector = protector
+	if !samplerRunning {
+		samplerRunning = true
+		go samplerLoop()
+	}
+	return wrapped
+}
+
+// udpTick is called by samplerOnce with samplerAccess held.
+func udpTick(now time.Time) {
+	var total uint64
+	perDest := map[string]uint64{}
+	addrs := map[string]*net.UDPAddr{}
+	for u := range udpConns {
+		sent := u.ctr.sent.Load()
+		delta := sent - u.lastSent
+		u.lastSent = sent
+		if u.ctr.closed.Load() {
+			delete(udpConns, u)
+		}
+		if delta == 0 {
+			continue
+		}
+		total += delta
+		// keyed by server IP: with Hysteria2 port hopping the port changes, the server does not
+		key := u.dest.IP.String()
+		perDest[key] += delta
+		addrs[key] = u.dest
+	}
+	for key, st := range udpDests {
+		if now.Sub(st.lastSeen) > udpProbeDestIdle {
+			delete(udpDests, key)
+		}
+	}
+	for key := range perDest {
+		st := udpDests[key]
+		if st == nil {
+			st = &udpDestState{}
+			udpDests[key] = st
+		}
+		st.lastSeen = now
+	}
+	if total == 0 || !udpSchedule.Add(total, now) || udpRoundRunning.Load() {
+		return
+	}
+	keys := make([]string, 0, len(perDest))
+	for key := range perDest {
+		if udpDests[key].prober.Method != dualnet.MethodNone {
+			keys = append(keys, key)
+		}
+	}
+	if len(keys) == 0 {
+		return
+	}
+	sort.Slice(keys, func(i, j int) bool { return perDest[keys[i]] > perDest[keys[j]] })
+	if len(keys) > udpProbeMaxDests {
+		keys = keys[:udpProbeMaxDests]
+	}
+	targets := make([]*net.UDPAddr, len(keys))
+	for i, key := range keys {
+		targets[i] = addrs[key]
+	}
+	udpRoundRunning.Store(true)
+	go udpProbeRound(targets, udpProtector)
+}
+
+func udpProbeRound(targets []*net.UDPAddr, protector Protector) {
+	defer udpRoundRunning.Store(false)
+	binder := currentSocketBinder()
+	if binder == nil {
+		return
+	}
+	var networks []string
+	for _, n := range strings.Split(binder.ActiveNetworks(), ",") {
+		if n = strings.TrimSpace(n); n != "" {
+			networks = append(networks, n)
+		}
+	}
+	if len(networks) == 0 {
+		return
+	}
+	for _, target := range targets {
+		key := target.IP.String()
+		samplerAccess.Lock()
+		st := udpDests[key]
+		var method dualnet.ProbeMethod
+		if st != nil {
+			method = st.prober.Method
+		}
+		samplerAccess.Unlock()
+		if st == nil {
+			continue
+		}
+		type result struct {
+			network string
+			rtt     time.Duration
+			err     error
+		}
+		results := make([]result, len(networks))
+		var wg sync.WaitGroup
+		for i, network := range networks {
+			wg.Add(1)
+			go func(i int, network string) {
+				defer wg.Done()
+				prepare := func(fd int) bool {
+					if protector != nil && !protector.Protect(int32(fd)) {
+						return false
+					}
+					return binder.BindSocketTo(int32(fd), network)
+				}
+				var rtt time.Duration
+				var err error
+				if method == dualnet.MethodQUIC {
+					rtt, err = dualnet.ProbeQUIC(target.IP, target.Port, udpProbeTimeout, prepare)
+				} else {
+					rtt, err = dualnet.ProbeTCP(target.IP, target.Port, udpProbeTimeout, prepare)
+				}
+				results[i] = result{network, rtt, err}
+			}(i, network)
+		}
+		wg.Wait()
+		anyReply := false
+		for _, r := range results {
+			if r.err == nil {
+				anyReply = true
+			}
+		}
+		samplerAccess.Lock()
+		reportTimeouts, changed := st.prober.RoundDone(anyReply)
+		newMethod, proven := st.prober.Method, st.prober.Proven
+		samplerAccess.Unlock()
+		for _, r := range results {
+			switch {
+			case r.err == nil:
+				reportSample(r.network, r.rtt.Microseconds(), -1, 0, false)
+			case r.err == dualnet.ErrPrepare:
+				// network went away / bind refused: not a measurement
+			case reportTimeouts:
+				reportSample(r.network, 0, -1, 1, true)
+			}
+		}
+		if changed || method != newMethod {
+			newError("dual-network: UDP probe for ", target, ": ", newMethod.String(), " proven=", proven).AtInfo().WriteToLog()
+			binder.UdpProbeState(target.String(), newMethod.String(), proven)
+		}
+	}
+}
