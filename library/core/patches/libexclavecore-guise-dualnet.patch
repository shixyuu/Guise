+
+// Package dualnet holds the platform-independent parts of Guise's passive dual-network
+// measurement: turning TCP_INFO counters into "bytes sent" and "loss", and the per-network
+// traffic trigger that decides when a sample is taken.
+package dualnet
+
+import "sync"
+
+// Counters is the subset of the kernel's struct tcp_info the sampler uses. Fields that the
+// running kernel does not provide are zero (older kernels return a shorter struct).
+type Counters struct {
+	BytesAcked   uint64 // tcpi_bytes_acked (Linux 4.1+)
+	SegsOut      uint32 // tcpi_segs_out (Linux 4.2+)
+	Mss          uint32 // tcpi_snd_mss
+	TotalRetrans uint32 // tcpi_total_retrans
+	LastDataSent uint32 // tcpi_last_data_sent, ms since the last data was sent
+}
+
+// SentDelta estimates the payload bytes sent between prev and cur. It prefers bytes_acked,
+// then segs_out × MSS. On kernels with neither it counts one MSS-sized "tick" worth of
+// threshold when data was sent within the last tickMs, so sampling still happens (at most
+// once per tick) while the connection is active.
+func SentDelta(prev, cur Counters, tickMs uint32, fallbackBytes uint64) uint64 {
+	switch {
+	case cur.BytesAcked > 0 || prev.BytesAcked > 0:
+		if cur.BytesAcked >= prev.BytesAcked {
+			return cur.BytesAcked - prev.BytesAcked
+		}
+		return 0
+	case cur.SegsOut > 0 || prev.SegsOut > 0:
+		if cur.SegsOut >= prev.SegsOut {
+			return uint64(cur.SegsOut-prev.SegsOut) * uint64(cur.Mss)
+		}
+		return 0
+	default:
+		if cur.LastDataSent < tickMs {
+			return fallbackBytes
+		}
+		return 0
+	}
+}
+
+// Loss is the share of segments retransmitted between two snapshots of one connection.
+func Loss(prev, cur Counters) float64 {
+	if cur.TotalRetrans <= prev.TotalRetrans {
+		return 0
+	}
+	retrans := float64(cur.TotalRetrans - prev.TotalRetrans)
+	var sent float64
+	switch {
+	case cur.SegsOut > prev.SegsOut:
+		sent = float64(cur.SegsOut - prev.SegsOut)
+	case cur.BytesAcked > prev.BytesAcked && cur.Mss > 0:
+		sent = float64(cur.BytesAcked-prev.BytesAcked)/float64(cur.Mss) + retrans
+	}
+	if sent < retrans {
+		sent = retrans
+	}
+	if sent == 0 {
+		return 0
+	}
+	return retrans / sent
+}
+
+// Trigger accumulates bytes sent per network and fires once every Threshold bytes.
+// Threshold 0 disables sampling.
+type Trigger struct {
+	access    sync.Mutex
+	threshold uint64
+	acc       map[string]uint64
+}
+
+func NewTrigger(threshold uint64) *Trigger {
+	return &Trigger{threshold: threshold, acc: map[string]uint64{}}
+}
+
+func (t *Trigger) Threshold() uint64 {
+	t.access.Lock()
+	defer t.access.Unlock()
+	return t.threshold
+}
+
+func (t *Trigger) SetThreshold(threshold uint64) {
+	t.access.Lock()
+	defer t.access.Unlock()
+	t.threshold = threshold
+	t.acc = map[string]uint64{}
+}
+
+// Add records n bytes sent on network and reports whether a sample is due. Bytes beyond the
+// threshold are dropped (one sample per call at most), so a burst does not queue up samples.
+func (t *Trigger) Add(network string, n uint64) bool {
+	t.access.Lock()
+	defer t.access.Unlock()
+	if t.threshold == 0 || n == 0 {
+		return false
+	}
+	t.acc[network] += n
+	if t.acc[network] >= t.threshold {
+		t.acc[network] = 0
+		return true
+	}
+	return false
+}
+
+func (t *Trigger) Reset() {
+	t.access.Lock()
+	defer t.access.Unlock()
+	t.acc = map[string]uint64{}
+}
diff --git a/dualnet/dualnet_test.go b/dualnet/dualnet_test.go
new file mode 100644
index 0000000..7f0475f
--- /dev/null
+++ b/dualnet/dualnet_test.go
@@ -0,0 +1,66 @@
+package dualnet
+
+import (
+	"math"
+	"testing"
+)
+
+func TestTriggerFiresEveryThreshold(t *testing.T) {
+	tr := NewTrigger(256 * 1024)
+	fired := 0
+	for i := 0; i < 100; i++ { // 100 × 64 KB = 6.25 MB on WiFi
+		if tr.Add("WiFi", 64*1024) {
+			fired++
+		}
+	}
+	if fired != 25 {
+		t.Fatalf("fired %d times, want 25", fired)
+	}
+	// per network: LTE has its own counter
+	if tr.Add("LTE", 200*1024) || !tr.Add("LTE", 100*1024) {
+		t.Fatal("LTE trigger wrong")
+	}
+	// burst: one sample, remainder dropped
+	if !tr.Add("WiFi", 10*1024*1024) || tr.Add("WiFi", 1) {
+		t.Fatal("burst should fire once and reset")
+	}
+	// no traffic, no sample
+	if tr.Add("WiFi", 0) {
+		t.Fatal("zero bytes fired")
+	}
+	tr.SetThreshold(0)
+	if tr.Add("WiFi", 1<<30) {
+		t.Fatal("disabled trigger fired")
+	}
+}
+
+func TestSentDelta(t *testing.T) {
+	if d := SentDelta(Counters{BytesAcked: 1000}, Counters{BytesAcked: 5000, SegsOut: 9}, 1000, 0); d != 4000 {
+		t.Fatalf("bytes_acked delta %d", d)
+	}
+	if d := SentDelta(Counters{SegsOut: 10, Mss: 1400}, Counters{SegsOut: 20, Mss: 1400}, 1000, 0); d != 14000 {
+		t.Fatalf("segs_out delta %d", d)
+	}
+	// old kernel: activity fallback
+	if d := SentDelta(Counters{}, Counters{LastDataSent: 200}, 1000, 4096); d != 4096 {
+		t.Fatalf("fallback active %d", d)
+	}
+	if d := SentDelta(Counters{}, Counters{LastDataSent: 5000}, 1000, 4096); d != 0 {
+		t.Fatalf("fallback idle %d", d)
+	}
+}
+
+func TestLoss(t *testing.T) {
+	if l := Loss(Counters{SegsOut: 100, TotalRetrans: 1}, Counters{SegsOut: 200, TotalRetrans: 6}); math.Abs(l-0.05) > 1e-9 {
+		t.Fatalf("loss %v", l)
+	}
+	if l := Loss(Counters{SegsOut: 100}, Counters{SegsOut: 200}); l != 0 {
+		t.Fatalf("no retrans loss %v", l)
+	}
+	if l := Loss(Counters{BytesAcked: 0, Mss: 1000}, Counters{BytesAcked: 9000, Mss: 1000, TotalRetrans: 1}); math.Abs(l-0.1) > 1e-9 {
+		t.Fatalf("bytes loss %v", l)
+	}
+	if l := Loss(Counters{}, Counters{TotalRetrans: 3}); l != 1 {
+		t.Fatalf("only retrans loss %v", l)
+	}
+}
diff --git a/dualnet/tcpinfo_linux_test.go b/dualnet/tcpinfo_linux_test.go
new file mode 100644
index 0000000..0c3479c
--- /dev/null
+++ b/dualnet/tcpinfo_linux_test.go
@@ -0,0 +1,60 @@
+//go:build linux
+
+package dualnet
+
+import (
+	"io"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Reads real TCP_INFO from a loopback connection the same way the sampler does.
+func TestTCPInfoOnLiveConn(t *testing.T) {
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		c, err := ln.Accept()
+		if err == nil {
+			io.Copy(io.Discard, c)
+			c.Close()
+		}
+	}()
+	conn, err := net.Dial("tcp4", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, _ := conn.(syscall.Conn).SyscallConn()
+	read := func() Counters {
+		var info *unix.TCPInfo
+		raw.Control(func(fd uintptr) { info, _ = unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO) })
+		if info.Rtt == 0 || info.State != 1 {
+			t.Fatalf("bad tcp_info: rtt=%d state=%d", info.Rtt, info.State)
+		}
+		return Counters{info.Bytes_acked, info.Segs_out, info.Snd_mss, info.Total_retrans, info.Last_data_sent}
+	}
+	before := read()
+	conn.Write(make([]byte, 1<<20))
+	time.Sleep(300 * time.Millisecond) // let the peer ack, as between two sampler ticks
+	after := read()
+	d := SentDelta(before, after, 1000, 0)
+	if d < 512*1024 {
+		t.Fatalf("delta %d", d)
+	}
+	tr := NewTrigger(256 * 1024)
+	if !tr.Add("WiFi", d) {
+		t.Fatal("trigger did not fire after 1 MB")
+	}
+	conn.Close()
+	err = raw.Control(func(uintptr) {})
+	if err == nil {
+		t.Fatal("Control on closed conn should fail (sampler relies on it)")
+	}
+	t.Logf("sent delta %d, loss %.3f", d, Loss(before, after))
+}
