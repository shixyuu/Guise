+along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+package dualnet
+
+import (
+	"crypto/rand"
+	"errors"
+	"net"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+var ErrPrepare = errors.New("socket preparation (protect/bind) failed")
+
+func sockaddr(ip net.IP, port int) (unix.Sockaddr, int) {
+	if ip4 := ip.To4(); ip4 != nil {
+		sa := &unix.SockaddrInet4{Port: port}
+		copy(sa.Addr[:], ip4)
+		return sa, unix.AF_INET
+	}
+	sa := &unix.SockaddrInet6{Port: port}
+	copy(sa.Addr[:], ip.To16())
+	return sa, unix.AF_INET6
+}
+
+// ProbeQUIC sends one version-negotiation probe to ip:port and waits for the VN reply.
+// prepare is called on the new socket before it is used (VpnService.protect + bind to the
+// network to measure). Returns the round-trip time.
+func ProbeQUIC(ip net.IP, port int, timeout time.Duration, prepare func(fd int) bool) (time.Duration, error) {
+	sa, family := sockaddr(ip, port)
+	fd, err := unix.Socket(family, unix.SOCK_DGRAM|unix.SOCK_CLOEXEC, unix.IPPROTO_UDP)
+	if err != nil {
+		return 0, err
+	}
+	defer unix.Close(fd)
+	if prepare != nil && !prepare(fd) {
+		return 0, ErrPrepare
+	}
+	if err := unix.Connect(fd, sa); err != nil {
+		return 0, err
+	}
+	ids := make([]byte, 16)
+	rand.Read(ids)
+	dcid, scid := ids[:8], ids[8:]
+	probe := BuildVNProbe(dcid, scid)
+	start := time.Now()
+	if _, err := unix.Write(fd, probe); err != nil {
+		return 0, err
+	}
+	buf := make([]byte, 1500)
+	for {
+		remaining := timeout - time.Since(start)
+		if remaining <= 0 {
+			return 0, errors.New("timeout")
+		}
+		tv := unix.NsecToTimeval(int64(remaining))
+		if tv.Sec == 0 && tv.Usec == 0 {
+			tv.Usec = 1
+		}
+		unix.SetsockoptTimeval(fd, unix.SOL_SOCKET, unix.SO_RCVTIMEO, &tv)
+		n, err := unix.Read(fd, buf)
+		if err != nil {
+			if errors.Is(err, unix.EAGAIN) || errors.Is(err, unix.EWOULDBLOCK) {
+				return 0, errors.New("timeout")
+			}
+			return 0, err
+		}
+		if IsVNReply(buf[:n], dcid, scid) {
+			return time.Since(start), nil
+		}
+	}
+}
+
+// ProbeTCP times a TCP connect to ip:port: a SYN-ACK or a RST (ECONNREFUSED) both measure one
+// round trip. The connection is reset right away (SO_LINGER 0), no data is sent.
+func ProbeTCP(ip net.IP, port int, timeout time.Duration, prepare func(fd int) bool) (time.Duration, error) {
+	sa, family := sockaddr(ip, port)
+	fd, err := unix.Socket(family, unix.SOCK_STREAM|unix.SOCK_NONBLOCK|unix.SOCK_CLOEXEC, unix.IPPROTO_TCP)
+	if err != nil {
+		return 0, err
+	}
+	defer unix.Close(fd)
+	unix.SetsockoptLinger(fd, unix.SOL_SOCKET, unix.SO_LINGER, &unix.Linger{Onoff: 1, Linger: 0})
+	if prepare != nil && !prepare(fd) {
+		return 0, ErrPrepare
+	}
+	start := time.Now()
+	err = unix.Connect(fd, sa)
+	if err != nil && !errors.Is(err, unix.EINPROGRESS) {
+		if errors.Is(err, unix.ECONNREFUSED) {
+			return time.Since(start), nil
+		}
+		return 0, err
+	}
+	if err == nil {
+		return time.Since(start), nil
+	}
+	fds := []unix.PollFd{{Fd: int32(fd), Events: unix.POLLOUT}}
+	for {
+		left := timeout - time.Since(start)
+		if left <= 0 {
+			return 0, errors.New("timeout")
+		}
+		n, err := unix.Poll(fds, int(left/time.Millisecond)+1)
+		if errors.Is(err, unix.EINTR) {
+			continue
+		}
+		if err != nil {
+			return 0, err
+		}
+		if n == 0 {
+			return 0, errors.New("timeout")
+		}
+		break
+	}
+	rtt := time.Since(start)
+	soErr, err := unix.GetsockoptInt(fd, unix.SOL_SOCKET, unix.SO_ERROR)
+	if err != nil {
+		return 0, err
+	}
+	if soErr == 0 || unix.Errno(soErr) == unix.ECONNREFUSED {
+		return rtt, nil
+	}
+	return 0, unix.Errno(soErr)
+}
