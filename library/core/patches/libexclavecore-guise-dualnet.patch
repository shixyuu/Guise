+
+You should have received a copy of the GNU General Public License
+along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+package libexclavecore
+
+// Guise: passive measurement of split (proxy-server) TCP connections.
+//
+// No extra packets are sent. While split connections are open, a 1 s ticker reads each one's
+// kernel TCP_INFO (a local getsockopt). Bytes sent are summed per network; every
+// "sample bytes" (SetDualNetSampleBytes) sent on a network, one sample is taken from that
+// network's busiest connection: smoothed RTT, RTT variance and the retransmitted share of
+// segments since that connection's previous sample. No traffic -> no samples. A connection
+// stuck in repeated retransmission timeouts with unacked data is reported as a failure, as are
+// connect() errors on split sockets; a connect() that succeeds contributes its handshake time.
+
+import (
+	"errors"
+	"net"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/exclavenetwork/libexclavecore/dualnet"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	samplerTick = time.Second
+	// fallback "bytes" per active tick on kernels without bytes_acked / segs_out
+	samplerFallbackBytes = 64 * 1024
+	// tcpi_retransmits (consecutive RTO count) at which a connection counts as stalled
+	samplerStallRetransmits = 3
+	tcpEstablished          = 1 // TCP_ESTABLISHED in include/net/tcp_states.h
+)
+
+type trackedConn struct {
+	raw        syscall.RawConn
+	network    string
+	last       dualnet.Counters // at previous tick
+	sampleBase dualnet.Counters // at previous sample of this connection
+	stalled    bool
+}
+
+var (
+	samplerAccess  sync.Mutex
+	samplerConns   = map[*trackedConn]struct{}{}
+	samplerRunning bool
+	samplerTrigger = dualnet.NewTrigger(0)
+)
+
+// SetDualNetSampleBytes sets after how many bytes sent per network one passive sample is
+// taken; 0 disables passive measurement (1:1 mode).
+func SetDualNetSampleBytes(bytes int64) {
+	if bytes < 0 {
+		bytes = 0
+	}
+	samplerTrigger.SetThreshold(uint64(bytes))
+}
+
+func resetSampler() {
+	samplerAccess.Lock()
+	defer samplerAccess.Unlock()
+	samplerConns = map[*trackedConn]struct{}{}
+	samplerTrigger.Reset()
+}
+
+func readTCPInfo(raw syscall.RawConn) (*unix.TCPInfo, error) {
+	var info *unix.TCPInfo
+	var infoErr error
+	err := raw.Control(func(fd uintptr) {
+		info, infoErr = unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return info, infoErr
+}
+
+func countersOf(info *unix.TCPInfo) dualnet.Counters {
+	return dualnet.Counters{
+		BytesAcked:   info.Bytes_acked,
+		SegsOut:      info.Segs_out,
+		Mss:          info.Snd_mss,
+		TotalRetrans: info.Total_retrans,
+		LastDataSent: info.Last_data_sent,
+	}
+}
+
+func reportSample(network string, rtt, rttVar int64, loss float64, failed bool) {
+	if binder := currentSocketBinder(); binder != nil {
+		binder.ReportSample(network, rtt, rttVar, loss, failed)
+	}
+}
+
+func reportConnect(network string, took time.Duration, err error) {
+	if samplerTrigger.Threshold() == 0 {
+		return
+	}
+	switch {
+	case err == nil:
+		reportSample(network, took.Microseconds(), -1, 0, false)
+	case errors.Is(err, unix.ECONNREFUSED):
+		// the server answered: the path works, nothing to learn about quality
+	default:
+		reportSample(network, 0, -1, 1, true)
+	}
+}
+
+func trackSplitConn(conn net.Conn, network string) {
+	if samplerTrigger.Threshold() == 0 {
+		return
+	}
+	sc, ok := conn.(syscall.Conn)
+	if !ok {
+		return
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return
+	}
+	tc := &trackedConn{raw: raw, network: network}
+	if info, err := readTCPInfo(raw); err == nil {
+		tc.last = countersOf(info)
+		tc.sampleBase = tc.last
+	}
+	samplerAccess.Lock()
+	defer samplerAccess.Unlock()
+	samplerConns[tc] = struct{}{}
+	if !samplerRunning {
+		samplerRunning = true
+		go samplerLoop()
+	}
+}
+
+func samplerLoop() {
+	ticker := time.NewTicker(samplerTick)
+	defer ticker.Stop()
+	for range ticker.C {
+		if !samplerOnce() {
+			return
+		}
+	}
+}
+
+type tickSample struct {
+	conn  *trackedConn
+	info  *unix.TCPInfo
+	delta uint64
+}
+
+// samplerOnce runs one tick; returns false (and marks the sampler stopped) when there is
+// nothing left to watch.
+func samplerOnce() bool {
+	samplerAccess.Lock()
+	if len(samplerConns) == 0 {
+		samplerRunning = false
+		samplerAccess.Unlock()
+		return false
+	}
+	conns := make([]*trackedConn, 0, len(samplerConns))
+	for c := range samplerConns {
+		conns = append(conns, c)
+	}
+	samplerAccess.Unlock()
+
+	busiest := map[string]tickSample{}
+	sent := map[string]uint64{}
+	var closed []*trackedConn
+	type failure struct{ network string }
+	var failures []failure
+	for _, c := range conns {
+		info, err := readTCPInfo(c.raw)
+		if err != nil || info.State != tcpEstablished {
+			// closed (Control fails on a closed conn) or no longer established
+			closed = append(closed, c)
+			continue
+		}
+		cur := countersOf(info)
+		delta := dualnet.SentDelta(c.last, cur, uint32(samplerTick/time.Millisecond), samplerFallbackBytes)
+		c.last = cur
+		stalled := info.Retransmits >= samplerStallRetransmits && info.Unacked > 0
+		if stalled && !c.stalled {
+			failures = append(failures, failure{c.network})
+		}
+		c.stalled = stalled
+		if delta == 0 || stalled {
+			continue
+		}
+		sent[c.network] += delta
+		if b, ok := busiest[c.network]; !ok || delta > b.delta {
+			busiest[c.network] = tickSample{c, info, delta}
+		}
+	}
+	if len(closed) > 0 {
+		samplerAccess.Lock()
+		for _, c := range closed {
+			delete(samplerConns, c)
+		}
+		samplerAccess.Unlock()
+	}
+	for _, f := range failures {
+		reportSample(f.network, 0, -1, 1, true)
+	}
+	for network, n := range sent {
+		if !samplerTrigger.Add(network, n) {
+			continue
+		}
+		b := busiest[network]
+		cur := countersOf(b.info)
+		loss := dualnet.Loss(b.conn.sampleBase, cur)
+		b.conn.sampleBase = cur
+		if b.info.Rtt == 0 {
+			continue
+		}
+		reportSample(network, int64(b.info.Rtt), int64(b.info.Rttvar), loss, false)
+	}
+	return true
+}
