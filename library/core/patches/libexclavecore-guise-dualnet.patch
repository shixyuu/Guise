+You should have received a copy of the GNU General Public License
+along with this program.  If not, see <https://www.gnu.org/licenses/>.
+*/
+
+package dualnet
+
+import (
+	"bytes"
+	"encoding/binary"
+	"sync"
+	"time"
+)
+
+// Active probing for UDP/QUIC proxy sessions (no TCP_INFO there).
+
+// ProbeVersion is a reserved QUIC version of the 0x?a?a?a?a form (RFC 9000 §15), which no
+// server supports, so a QUIC server must answer with a Version Negotiation packet.
+const ProbeVersion = 0x1a2a3a4a
+
+// ProbeSize: servers only answer unknown versions in datagrams of at least 1200 bytes.
+const ProbeSize = 1200
+
+// BuildVNProbe returns a 1200-byte QUIC long-header packet with version ProbeVersion.
+func BuildVNProbe(dcid, scid []byte) []byte {
+	b := make([]byte, 0, ProbeSize)
+	b = append(b, 0xc0|0x0f) // long header, fixed bit, arbitrary type bits
+	b = binary.BigEndian.AppendUint32(b, ProbeVersion)
+	b = append(b, byte(len(dcid)))
+	b = append(b, dcid...)
+	b = append(b, byte(len(scid)))
+	b = append(b, scid...)
+	for len(b) < ProbeSize {
+		b = append(b, 0)
+	}
+	return b
+}
+
+// IsVNReply reports whether pkt is a Version Negotiation packet answering a probe sent with
+// (dcid, scid): long header, version 0, and the connection IDs echoed swapped.
+func IsVNReply(pkt, dcid, scid []byte) bool {
+	if len(pkt) < 7 || pkt[0]&0x80 == 0 || binary.BigEndian.Uint32(pkt[1:5]) != 0 {
+		return false
+	}
+	p := pkt[5:]
+	dl := int(p[0])
+	if len(p) < 1+dl+1 || !bytes.Equal(p[1:1+dl], scid) {
+		return false
+	}
+	p = p[1+dl:]
+	sl := int(p[0])
+	if len(p) < 1+sl || !bytes.Equal(p[1:1+sl], dcid) {
+		return false
+	}
+	return len(p[1+sl:]) >= 4 && len(p[1+sl:])%4 == 0 // at least one supported version
+}
+
+type ProbeMethod int
+
+const (
+	// MethodQUIC sends a QUIC version-negotiation probe to the session's server ip:port.
+	MethodQUIC ProbeMethod = iota
+	// MethodTCP times a TCP connect to the same ip:port (SYN-ACK or RST both count).
+	MethodTCP
+	// MethodNone: nothing answers; the destination is not probed any more.
+	MethodNone
+)
+
+func (m ProbeMethod) String() string {
+	switch m {
+	case MethodQUIC:
+		return "quic-vn"
+	case MethodTCP:
+		return "tcp-connect"
+	default:
+		return "off"
+	}
+}
+
+const (
+	// rounds without any reply (on any network) before trying the next method
+	unprovenRoundsBeforeFallback = 2
+	// rounds without any reply after the method had worked before it is re-evaluated
+	provenRoundsBeforeReset = 5
+)
+
+// DestProber chooses how one UDP server is probed. Timeouts only count as failures (loss)
+// once the method has been seen working for this server, so a server that never answers
+// probes (e.g. Hysteria2 with salamander obfuscation, WireGuard) does not make a network look
+// dead: the prober falls back QUIC → TCP → off instead.
+type DestProber struct {
+	Method       ProbeMethod
+	Proven       bool
+	failedRounds int
+}
+
+// RoundDone records a probe round (one probe per network). It returns whether the round's
+// timeouts should be reported as failures, and whether the method changed.
+func (d *DestProber) RoundDone(anyReply bool) (reportTimeouts bool, changed bool) {
+	reportTimeouts = d.Proven
+	if anyReply {
+		changed = !d.Proven
+		d.Proven = true
+		d.failedRounds = 0
+		return
+	}
+	d.failedRounds++
+	if d.Proven {
+		if d.failedRounds >= provenRoundsBeforeReset {
+			d.Proven = false
+			d.failedRounds = 0
+			changed = true
+		}
+		return
+	}
+	if d.failedRounds >= unprovenRoundsBeforeFallback && d.Method != MethodNone {
+		d.Method++
+		d.failedRounds = 0
+		changed = true
+	}
+	return
+}
+
+// UDPSchedule fires a probe round when at least Threshold bytes were sent over UDP split
+// sessions since the last round and at least MinInterval has passed. MinInterval 0 disables.
+type UDPSchedule struct {
+	access      sync.Mutex
+	threshold   uint64
+	minInterval time.Duration
+	acc         uint64
+	last        time.Time
+}
+
+func (s *UDPSchedule) Configure(threshold uint64, minInterval time.Duration) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.threshold, s.minInterval, s.acc, s.last = threshold, minInterval, 0, time.Time{}
+}
+
+func (s *UDPSchedule) Enabled() bool {
+	s.access.Lock()
+	defer s.access.Unlock()
+	return s.minInterval > 0 && s.threshold > 0
+}
+
+func (s *UDPSchedule) Add(n uint64, now time.Time) bool {
+	s.access.Lock()
+	defer s.access.Unlock()
+	if s.minInterval <= 0 || s.threshold == 0 {
+		return false
+	}
+	s.acc += n
+	if s.acc < s.threshold || (!s.last.IsZero() && now.Sub(s.last) < s.minInterval) {
+		return false
+	}
+	s.acc = 0
+	s.last = now
+	return true
+}
diff --git a/dualnet/udpprobe_test.go b/dualnet/udpprobe_test.go
new file mode 100644
index 0000000..7c7bb0d
--- /dev/null
+++ b/dualnet/udpprobe_test.go
@@ -0,0 +1,84 @@
+package dualnet
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+	"time"
+)
+
+func TestVNProbeFormat(t *testing.T) {
+	dcid := []byte{1, 2, 3, 4, 5, 6, 7, 8}
+	scid := []byte{9, 10, 11, 12}
+	p := BuildVNProbe(dcid, scid)
+	if len(p) != 1200 || p[0]&0xc0 != 0xc0 || binary.BigEndian.Uint32(p[1:5]) != ProbeVersion {
+		t.Fatal("bad probe header")
+	}
+	if p[5] != 8 || !bytes.Equal(p[6:14], dcid) || p[14] != 4 || !bytes.Equal(p[15:19], scid) {
+		t.Fatal("bad connection ids")
+	}
+	// a VN reply echoes the ids swapped
+	reply := []byte{0x80, 0, 0, 0, 0, 4}
+	reply = append(reply, scid...)
+	reply = append(reply, 8)
+	reply = append(reply, dcid...)
+	reply = append(reply, 0, 0, 0, 1)
+	if !IsVNReply(reply, dcid, scid) {
+		t.Fatal("valid reply rejected")
+	}
+	bad := append([]byte{}, reply...)
+	bad[6] ^= 0xff
+	if IsVNReply(bad, dcid, scid) || IsVNReply(reply[:10], dcid, scid) {
+		t.Fatal("bad reply accepted")
+	}
+}
+
+func TestDestProberFallback(t *testing.T) {
+	var d DestProber
+	if r, _ := d.RoundDone(false); r || d.Method != MethodQUIC {
+		t.Fatal("first timeout must not count")
+	}
+	if _, ch := d.RoundDone(false); !ch || d.Method != MethodTCP {
+		t.Fatal("should fall back to TCP after 2 silent rounds")
+	}
+	d.RoundDone(false)
+	d.RoundDone(false)
+	if d.Method != MethodNone {
+		t.Fatal("should give up after TCP is silent too")
+	}
+
+	var q DestProber
+	if r, ch := q.RoundDone(true); r || !ch || !q.Proven {
+		t.Fatal("reply should prove QUIC")
+	}
+	if r, _ := q.RoundDone(false); !r {
+		t.Fatal("timeouts after proof are loss")
+	}
+	for i := 0; i < 4; i++ {
+		q.RoundDone(false)
+	}
+	if q.Proven || q.Method != MethodQUIC {
+		t.Fatal("5 silent rounds should reset the proof")
+	}
+}
+
+func TestUDPSchedule(t *testing.T) {
+	var s UDPSchedule
+	now := time.Unix(1000, 0)
+	if s.Add(1<<30, now) {
+		t.Fatal("unconfigured schedule fired")
+	}
+	s.Configure(256*1024, 10*time.Second)
+	if s.Add(100*1024, now) || !s.Add(200*1024, now) {
+		t.Fatal("threshold")
+	}
+	if s.Add(1<<20, now.Add(5*time.Second)) {
+		t.Fatal("min interval not respected")
+	}
+	if !s.Add(0, now.Add(10*time.Second)) {
+		t.Fatal("accumulated bytes should fire after the interval")
+	}
+	if s.Add(0, now.Add(30*time.Second)) {
+		t.Fatal("no traffic, no probe")
+	}
+}
