@@ -0,0 +1,89 @@
+//go:build linux
+
+package dualnet
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	apernetquic "github.com/apernet/quic-go"
+	"github.com/quic-go/quic-go"
+)
+
+func selfSigned(t *testing.T) tls.Certificate {
+	key, _ := rsa.GenerateKey(rand.Reader, 2048)
+	tpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "probe"}, NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, tpl, tpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+// A real quic-go server (as used by Hysteria2 / Juicity servers) answers the probe.
+func TestProbeQUICAgainstQuicGo(t *testing.T) {
+	ln, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{selfSigned(t)}, NextProtos: []string{"h3"}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go ln.Accept(context.Background())
+	addr := ln.Addr().(*net.UDPAddr)
+	prepared := false
+	rtt, err := ProbeQUIC(addr.IP, addr.Port, time.Second, func(fd int) bool { prepared = true; return true })
+	if err != nil || !prepared {
+		t.Fatalf("probe failed: %v", err)
+	}
+	t.Logf("quic-vn rtt %v", rtt)
+
+	// nothing listening -> timeout (loopback ICMP unreachable shows up as ECONNREFUSED)
+	if _, err := ProbeQUIC(addr.IP, 1, 300*time.Millisecond, nil); err == nil {
+		t.Fatal("probe to closed port succeeded")
+	}
+	// a failing prepare (protect/bind) aborts
+	if _, err := ProbeQUIC(addr.IP, addr.Port, time.Second, func(int) bool { return false }); err != ErrPrepare {
+		t.Fatalf("prepare failure: %v", err)
+	}
+}
+
+// The quic-go fork used by Hysteria2 servers (without salamander obfuscation) answers too.
+func TestProbeQUICAgainstHysteriaQuicGo(t *testing.T) {
+	ln, err := apernetquic.ListenAddr("127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{selfSigned(t)}, NextProtos: []string{"h3"}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go ln.Accept(context.Background())
+	addr := ln.Addr().(*net.UDPAddr)
+	if _, err := ProbeQUIC(addr.IP, addr.Port, time.Second, nil); err != nil {
+		t.Fatalf("probe failed: %v", err)
+	}
+}
+
+func TestProbeTCP(t *testing.T) {
+	ln, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := ln.Addr().(*net.TCPAddr).Port
+	if _, err := ProbeTCP(net.IPv4(127, 0, 0, 1), port, time.Second, nil); err != nil {
+		t.Fatalf("open port: %v", err)
+	}
+	ln.Close()
+	// closed port answers RST: still a round trip
+	if _, err := ProbeTCP(net.IPv4(127, 0, 0, 1), port, time.Second, nil); err != nil {
+		t.Fatalf("closed port (RST): %v", err)
+	}
+	// unroutable (TEST-NET-1, dropped) -> timeout or unreachable
+	if _, err := ProbeTCP(net.IPv4(192, 0, 2, 1), 443, 300*time.Millisecond, nil); err == nil {
+		t.Fatal("black hole answered")
+	}
+}
