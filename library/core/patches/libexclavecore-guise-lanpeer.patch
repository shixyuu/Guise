@@ -0,0 +1,117 @@
+package libexclavecore
+
+import (
+	"fmt"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+
+	v2rayNet "github.com/exclavenetwork/exclave-core/v5/common/net"
+	"golang.org/x/sys/unix"
+)
+
+type testLanAuth struct {
+	allow    atomic.Int32
+	bindOk   atomic.Bool
+	quotaMax int64
+	used     atomic.Int64
+	lastName atomic.Value
+}
+
+func (a *testLanAuth) AuthorizePeer(clientId, clientName, clientIp, token string) int32 {
+	a.lastName.Store(clientName)
+	return a.allow.Load()
+}
+
+func (a *testLanAuth) ReportPeerTraffic(clientId string, bytes int64) bool {
+	total := a.used.Add(bytes)
+	if a.quotaMax > 0 && total > a.quotaMax {
+		return false
+	}
+	return true
+}
+
+func (a *testLanAuth) BindHostSocket(fd int32) bool {
+	return a.bindOk.Load()
+}
+
+func TestLanPeerServerRelayAndQuota(t *testing.T) {
+	allowLoopbackForTest = true
+	defer func() { allowLoopbackForTest = false }()
+
+	// Echo server as target
+	echoLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echoLn.Close()
+	go func() {
+		for {
+			c, err := echoLn.Accept()
+			if err != nil {
+				return
+			}
+			go func(conn net.Conn) {
+				defer conn.Close()
+				_, _ = io.Copy(conn, conn)
+			}(c)
+		}
+	}()
+	echoAddr := echoLn.Addr().(*net.TCPAddr)
+
+	auth := &testLanAuth{quotaMax: 0}
+	auth.allow.Store(1)
+	auth.bindOk.Store(true)
+
+	port, err := StartLanPeerServer(0, auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer StopLanPeerServer()
+
+	// 1. Successful dialViaLanPeer
+	fd, err := unix.Socket(unix.AF_INET, unix.SOCK_STREAM, unix.IPPROTO_TCP)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dest := v2rayNet.TCPDestination(v2rayNet.IPAddress(echoAddr.IP), v2rayNet.Port(echoAddr.Port))
+	endpoint := fmt.Sprintf("127.0.0.1:%d|dev1|Pixel8|tok123", port)
+	conn, err := dialViaLanPeer(fd, endpoint, dest)
+	if err != nil {
+		unix.Close(fd)
+		t.Fatalf("dialViaLanPeer failed: %v", err)
+	}
+	msg := []byte("hello-lan-peer")
+	if _, err := conn.Write(msg); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(conn, buf); err != nil {
+		t.Fatal(err)
+	}
+	if string(buf) != string(msg) {
+		t.Fatalf("got %q, want %q", buf, msg)
+	}
+	conn.Close()
+	if got := auth.lastName.Load(); got != "Pixel8" {
+		t.Fatalf("clientName = %v, want Pixel8", got)
+	}
+
+	// 2. Denied authorization
+	auth.allow.Store(-1)
+	fd2, _ := unix.Socket(unix.AF_INET, unix.SOCK_STREAM, unix.IPPROTO_TCP)
+	if _, err := dialViaLanPeer(fd2, endpoint, dest); err == nil {
+		t.Fatal("expected error when peer denied")
+	}
+	unix.Close(fd2)
+
+	// 3. Anti-loop: BindHostSocket=false must reject
+	auth.allow.Store(1)
+	auth.bindOk.Store(false)
+	fd3, _ := unix.Socket(unix.AF_INET, unix.SOCK_STREAM, unix.IPPROTO_TCP)
+	if _, err := dialViaLanPeer(fd3, endpoint, dest); err == nil {
+		t.Fatal("expected error when BindHostSocket fails")
+	}
+	unix.Close(fd3)
+}
