-	if sockopt == nil || sockopt.Mark != GuiseSplitMark {
-		return false, sockopt
+// takeGuiseMarks reports whether sockopt carries Guise split/shape marks and returns sockopt without them.
+func takeGuiseMarks(sockopt *internet.SocketConfig) (split bool, shape bool, clean *internet.SocketConfig) {
+	if sockopt == nil {
+		return false, false, nil
+	}
+	switch sockopt.Mark {
+	case GuiseSplitMark:
+		split = true
+	case GuiseShapeMark:
+		shape = true
+	case GuiseSplitShapeMark:
+		split = true
+		shape = true
+	default:
+		return false, false, sockopt
 	}
